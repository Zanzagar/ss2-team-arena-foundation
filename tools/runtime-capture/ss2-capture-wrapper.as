/**
 * SS2 runtime-capture wrapper (ActionScript 2, AVM1) — UNVALIDATED DRAFT.
 *
 * Independently authored instrumentation host for controlled 1v1 capture
 * sessions against the licensed Swords & Sandals II SWF identified in
 * docs/integration/ss2-build-fingerprint.json. It loads the installed file in
 * place (never a copy), never patches it, and emits only the JSONL trace
 * grammar from docs/integration/ss2-runtime-capture.md via trace().
 *
 * STATUS: this source cannot be compiled or executed yet — no AVM1-capable
 * player or AS2 compiler is installed. Before any emitted trace is trusted:
 *   1. an approved local player (Ruffle desktop preferred) must be installed;
 *   2. Object.watch, timeline-function wrapping, level loading, and the
 *      overlay instance path must be verified against that player;
 *   3. the wrapper must byte-reproduce the reference traces generated by
 *      src/golden/simulate-capture-trace.js (modulo meta identity and
 *      passive roll values) for a staged candidate scenario.
 *
 * Runtime configuration arrives via FlashVars / loader query string — the
 * install path and session identity are never embedded in this file:
 *   gameUrl        file: URL of the installed swords_sandals2_download.swf
 *   observationId  token
 *   sessionId      token
 *   toolVersion    e.g. ss2-capture/0.1.0
 *   observedAt     ISO timestamp recorded by the operator
 *   hashBefore     "true" only after tools/capture-session.mjs verify-install
 *   hashAfter      confirmed by re-running verify-install; ingest refuses
 *                  the trace unless both attestations are true
 *   injected       "true" => serve the fixture tape from randomBetween
 *   tape           comma list label:min:max:value in fixture order
 *   watchFields    comma list of game-object fields to watch (defaults below)
 *
 * Operator flow: a lethal action finishes automatically after the overlay
 * result label; for non-lethal captures press END after the action resolves
 * to dump final state and close the trace.
 */

// ---------------------------------------------------------------------------
// Minimal JSON emitter (AS2 has no JSON object). Numbers, booleans, strings,
// flat objects, and arrays only — exactly what the trace grammar needs.
// ---------------------------------------------------------------------------
function jsonString(value) {
    var type = typeof value;
    if (value == null) return "null";
    if (type == "number" || type == "boolean") return String(value);
    if (type == "string") {
        var out = "\"";
        for (var i = 0; i < value.length; i++) {
            var c = value.charAt(i);
            if (c == "\"" || c == "\\") out += "\\" + c;
            else if (c == "\r") out += "\\r";
            else if (c == "\n") out += "\\n";
            else if (c == "\t") out += "\\t";
            else out += c;
        }
        return out + "\"";
    }
    if (value instanceof Array) {
        var items = [];
        for (var a = 0; a < value.length; a++) items.push(jsonString(value[a]));
        return "[" + items.join(",") + "]";
    }
    var pairs = [];
    for (var key in value) pairs.push(jsonString(key) + ":" + jsonString(value[key]));
    return "{" + pairs.join(",") + "}";
}

function emit(line) {
    trace(jsonString(line)); // Ruffle desktop: RUST_LOG=avm_trace=info captures this
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------
var config = {
    gameUrl: _root.gameUrl,
    observationId: _root.observationId,
    sessionId: _root.sessionId,
    toolVersion: _root.toolVersion,
    observedAt: _root.observedAt,
    hashBefore: _root.hashBefore == "true",
    injected: _root.injected == "true"
};

var tape = [];      // [{label, min, max, value}] in fixture order
var tapeCursor = 0;
if (_root.tape != undefined && _root.tape != "") {
    var entries = _root.tape.split(",");
    for (var t = 0; t < entries.length; t++) {
        var parts = entries[t].split(":");
        tape.push({ label: parts[0], min: Number(parts[1]), max: Number(parts[2]), value: Number(parts[3]) });
    }
}

var DEFAULT_WATCH_FIELDS = [
    // the 18 projected fields ...
    "hitpoints", "armourclass", "armourclass_max", "staminaleft",
    "burning", "frozen", "poison", "life_stolen", "taunted1", "taunted2",
    "helmet", "shoulderguard", "breastplate", "gauntlet", "greaves",
    "shinguard", "boot", "shield",
    // ... plus staged-scenario inputs so ingest chain checks always anchor
    "attack", "defence", "strength", "charisma", "magicka",
    "min_damage", "max_damage", "hitpointsmax", "staminamax", "ammo_left"
];
var watchFields = _root.watchFields != undefined && _root.watchFields != ""
    ? _root.watchFields.split(",")
    : DEFAULT_WATCH_FIELDS;

// The mapped call-site for the wrapped randomBetween definitions.
var CALL_SITE = "overlay:862/frame:52/DoAction@0x240c7f";

emit({
    t: "meta",
    schemaVersion: 1,
    observationId: config.observationId,
    sessionId: config.sessionId,
    captureToolVersion: config.toolVersion,
    method: config.injected ? "injected-tape-runtime" : "passive-runtime",
    observedAt: config.observedAt,
    mutationGranularity: "property-watch",
    installHashVerifiedBefore: config.hashBefore,
    attackerSide: "hero"
});

// ---------------------------------------------------------------------------
// Load the installed game in place, on its own level so its _root stays its
// own root timeline (no _lockroot juggling, no changes to the loaded movie).
// ---------------------------------------------------------------------------
loadMovieNum(config.gameUrl, 1);

var currentHook = "unattributed";   // set/cleared by function wraps
var battleHooked = false;
var stateDumped = false;
var finalsDumped = false;
var resultSeen = false;

function gameRoot() { return _level1; }
function gameObject(side) { return gameRoot().game[side == "hero" ? "hero" : "villain"]; }
// VALIDATION ITEM: confirm the overlay controller instance path on the live
// timeline (the battle map records the linkage, not the instance name).
function overlayClip() { return gameRoot().arena.overlay; }

function dumpSide(kind, side) {
    var source = gameObject(side);
    var fields = {};
    for (var i = 0; i < watchFields.length; i++) {
        var name = watchFields[i];
        if (source[name] !== undefined) fields[name] = source[name];
    }
    if (source.gladiator_dir !== undefined) fields.gladiator_dir = source.gladiator_dir;
    emit({ t: kind, side: side, fields: fields });
}

// Object.watch callback: fires per assignment, before the write lands.
function makeWatcher(side) {
    return function (prop, oldValue, newValue) {
        emit({
            t: "set",
            path: "/" + side + "/" + prop,
            before: oldValue,
            after: newValue,
            hook: currentHook
        });
        return newValue;
    };
}

function wrapHook(owner, name, hookLabel, onEnter) {
    var original = owner[name];
    if (typeof original != "function") return false;
    owner[name] = function () {
        var previous = currentHook;
        currentHook = hookLabel;
        if (onEnter != undefined) onEnter(arguments);
        var result = original.apply(this, arguments);
        currentHook = previous;
        return result;
    };
    return true;
}

function wrapRandomBetween(owner) {
    var original = owner.randomBetween;
    if (typeof original != "function") return false;
    owner.randomBetween = function (a, b) {
        var sample = tape[tapeCursor];
        var matches = sample != undefined && sample.min == a && sample.max == b;
        var value;
        var label;
        if (config.injected && matches) {
            value = sample.value;
            label = sample.label;
        } else {
            // Tape exhaustion or a bounds mismatch means the game diverged
            // from the candidate's expected roll order: fall back to the real
            // RNG and keep recording so the divergent trace stays ingestable.
            value = original(a, b);
            label = matches ? sample.label : "unexpected-" + tapeCursor;
        }
        tapeCursor++;
        emit({
            t: "roll", label: label, source: "randomBetween",
            min: a, max: b, value: value,
            callSite: CALL_SITE, injected: config.injected && matches
        });
        return value;
    };
    return true;
}

function hookBattle() {
    var root = gameRoot();
    if (root == undefined || root.game == undefined) return;
    if (root.game.hero == undefined || root.game.villain == undefined) return;
    var overlay = overlayClip();
    if (overlay == undefined || typeof overlay.randomBetween != "function") return;

    wrapRandomBetween(overlay);
    wrapRandomBetween(root); // root frame 35 duplicate definition

    wrapHook(overlay, "checkattackroll", "check-attack-roll", function () {
        emit({ t: "var", name: "attack_direction", value: overlay.attack_direction });
        if (overlay.criticalhit != undefined) {
            emit({ t: "var", name: "criticalhit", value: overlay.criticalhit });
        }
    });
    wrapHook(overlay, "damagecharacter", "damagecharacter");
    wrapHook(overlay, "magic_damage_character", "damagecharacter");
    wrapHook(overlay, "remove_armour", "remove-armour");
    wrapHook(overlay, "destroy_armour", "remove-armour");
    wrapHook(overlay, "nextphase", "next-phase");
    wrapHook(overlay, "check_spells", "check-spells");
    wrapHook(overlay, "defender_hurt", "damagecharacter", function (args) {
        emit({ t: "event", type: "defender-hurt", method: String(args[0]) });
    });
    wrapHook(overlay, "defender_blocked", "check-attack-roll", function () {
        emit({ t: "event", type: "defender-blocked" });
    });
    wrapHook(overlay, "death", "death", function (args) {
        var clip = args[0];
        var side = clip == root.arena.gladiators.villain ? "villain" : "hero";
        emit({ t: "event", type: "death", side: side });
    });

    // Overlay result labels surface through gotoAndPlay on the controller.
    var originalGoto = overlay.gotoAndPlay;
    overlay.gotoAndPlay = function (label) {
        if (label == "combatwon" || label == "combatlost") {
            emit({ t: "event", type: "overlay-label", label: label });
            resultSeen = true;
        }
        return originalGoto.apply(this, arguments);
    };

    var sides = ["hero", "villain"];
    for (var s = 0; s < sides.length; s++) {
        var side = sides[s];
        var target = gameObject(side);
        for (var f = 0; f < watchFields.length; f++) {
            target.watch(watchFields[f], makeWatcher(side));
        }
    }
    battleHooked = true;
}

function finishTrace() {
    if (finalsDumped) return;
    dumpSide("final", "hero");
    dumpSide("final", "villain");
    emit({ t: "end", installHashVerifiedAfter: _root.hashAfter == "true" });
    finalsDumped = true;
}

// END key closes a non-lethal capture once the action has resolved.
var keyListener = {
    onKeyDown: function () {
        if (Key.getCode() == Key.END && stateDumped) finishTrace();
    }
};
Key.addListener(keyListener);

// ---------------------------------------------------------------------------
// Driver loop: hook once the battle exists, dump staged state at
// battle_started, close automatically after a lethal overlay label.
// ---------------------------------------------------------------------------
this.onEnterFrame = function () {
    if (!battleHooked) { hookBattle(); return; }
    if (!stateDumped && _global.battle_started == true) {
        dumpSide("state", "hero");
        dumpSide("state", "villain");
        stateDumped = true;
    }
    if (resultSeen && !finalsDumped) finishTrace();
};
